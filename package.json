  "version": "1.0.6",
  "description": "Real-time cymatics: music drives a WebGL2 wave simulation of a vibrating fluid surface.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Miika Kuisma",
  "contributors": [
    "Tuomo Hirvonen (original glbase engine)"
  ],
  "homepage": "https://cymatics.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miikakuisma/cymatics.git"
  },
  "bugs": {
